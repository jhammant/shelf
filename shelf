def days_between(start: str, end: str) -> int:
    try:
        delta = datetime.datetime.fromisoformat(end) - datetime.datetime.fromisoformat(start)
        return max(delta.days, 0)
    except ValueError:
        return 0


def days_since(date: str) -> int:
    try:
        return (datetime.date.today() - datetime.date.fromisoformat(date)).days
    except ValueError:
        return 10_000  # no `added` date: treat as old enough to judge


def cmd_stats(args):
    """HUMAN: is the shelf changing decisions? Linear in shelf size — not for agents."""
    ensure_shelf()
    if args.off:
        (shelf_dir() / LOG_OFF_NAME).write_text("usage logging off\n", encoding="utf-8")
        log_path().unlink(missing_ok=True)
        print(f"usage logging off — {log_path()} deleted. back on with `shelf stats --on`")
        return
    if args.on:
        (shelf_dir() / LOG_OFF_NAME).unlink(missing_ok=True)
        print(f"usage logging on — find/show recorded locally in {log_path()}")
        return
    acc = new_stats()
    for rec in read_log():
        fold(acc, rec)
    items = load()
    counts = acc["items"]
    if args.json:
        print(json.dumps(acc, indent=2, sort_keys=True))
        return

    bold, dim, off = ("\033[1m", "\033[2m", "\033[0m") if colour_on() else ("", "", "")
    if not acc["finds"] and not acc["shows"]:
        print("nothing retrieved yet — the log starts on your next `shelf find`")
        if logging_off():
            print("(logging is off — turn it back on with `shelf stats --on`)")
        return
    window = days_between(acc["since"], acc["to"]) or 1
    kept = acc["finds"] - acc["misses"]
    print(f"\n{bold}Shelf impact{off} {dim}— {len(items)} items · {window}d "
          f"since {acc['since'][:10]}{off}\n")
    total = acc["finds"] + acc["shows"]
    print(f"  {'searches':<16}{acc['finds']:>6,}   {kept:,} hit "
          f"({100 * kept // max(acc['finds'], 1)}%) · {acc['misses']:,} missed")
    print(f"  {'notes opened':<16}{acc['shows']:>6,}")
    print(f"  {'retrievals':<16}{total:>6,}   {dim}{acc['piped']:,} piped (an agent, most likely) · "
          f"{total - acc['piped']:,} at a terminal (you){off}")

    order = sorted(acc["surfaced"], key=lambda v: VERDICT_ORDER.get(v, 9))
    print("\n  " + f"{'surfaced':<16}" + " · ".join(f"{v} {acc['surfaced'][v]:,}" for v in order))
    print(f"  {bold}{'re-research':<16}{acc['opened'].get('rejected', 0):>6,}{off}   "
          f"rejected notes opened {dim}· {acc['surfaced'].get('rejected', 0):,} rejected "
          f"verdicts surfaced in results{off}")

    ranked = sorted(counts.items(), key=lambda p: (-(p[1][0] + p[1][1]), p[0]))
    if ranked:
        print(f"\n{bold}most retrieved{off}")
        by_slug = {i["name"]: i for i in items}
        for slug, (f, s) in ranked[:STATS_TOP]:
            item = by_slug.get(slug)
            print(f"  {slug:<26}{f + s:>4}  {dim}find {f} · show {s}{off}  "
                  f"{verdict_of(item) if item else 'deleted'}")

    if acc["missed"]:
        misses = sorted(acc["missed"].items(), key=lambda p: (-p[1], p[0]))[:STATS_TOP]
        print(f"\n{bold}missed searches{off} {dim}— gaps worth shelving{off}")
        for query, n in misses:
            print(f"  {clip(query, 40):<26}{n:>4}")

    dead = sorted((i for i in items if not counts.get(i["name"])
                   and min(window, days_since(i["added"])) >= DEAD_GRACE_DAYS),
                  key=lambda i: i["added"])
    if dead:
        print(f"\n{bold}never retrieved{off} {dim}— {len(dead)} of {len(items)} items, "
              f"shelved >{DEAD_GRACE_DAYS}d and never surfaced{off}")
        for i in (dead if args.dead else dead[:STATS_TOP]):
            print(f"  {i['name']:<26}{dim}added {i['added']}  {','.join(tags_of(i))}{off}")
        if not args.dead and len(dead) > STATS_TOP:
            print(f"  {dim}… {len(dead) - STATS_TOP} more — `shelf stats --dead`{off}")
    print()


def render_index():
    items = load()
    cons = load_constraints()
    cites = citations()
    out = [
        "# Shelf",
        "",
        "Things that might be useful on a future project.",
        "Generated by [shelf](https://github.com/jhammant/shelf) — do not edit by hand.",
        "",
    ]
    if cons:
        out += ["## Constraints", ""]
        for c in cons:
            n = len(cites.get(c["id"], ()))
            text = c["text"].replace("|", "\\|")
            state = f" — lifted {c['lifted']}" if c["lifted"] else ""
            cited = f" · {n} cited" if n else ""
            out.append(f"- `{c['id']}` — {text}{state}{cited}")
        out.append("")
    by_kind: dict = {}
    for i in items:
        by_kind.setdefault(kind_of(i), []).append(i)
    headers = len(by_kind) > 1
    for kind in KINDS:
        group = by_kind.get(kind)
        if not group:
            continue
        if headers:
            out += [f"## {KIND_TITLE[kind]}", ""]
        out += ["| Item | Why it's here | Tags | Verdict | Added |",
                "| --- | --- | --- | --- | --- |"]
        for i in group:
            link = f"[{i['name']}]({i['url']})" if i["url"] else i["name"]
            why = i["why"].replace("|", "\\|")
            ids = because_of(i)
            verdict = verdict_of(i) + (f" ({','.join(ids)})" if ids else "")
            out.append(
                f"| {link} · [notes](items/{i['name']}.md) | {why} "
                f"| {','.join(tags_of(i))} | {verdict} | {i['added']} |"
            )
        legend = " · ".join(f"`{v}`" for v in VERDICTS_BY_KIND[kind])
        out += ["", f"_Verdicts: {legend}._", ""]
    while out and out[-1] == "":
        out.pop()
    (shelf_dir() / "README.md").write_text("\n".join(out) + "\n", encoding="utf-8")


def cmd_index(args):
    ensure_shelf()
    render_index()
    print(f"{shelf_dir() / 'README.md'} regenerated")


# ---------------------------------------------------------------- cli

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="shelf",
        description="A context-budgeted store for tools you might use on a future project.",
        epilog="Data lives in $SHELF_DIR (default ~/.shelf).",
    )
    p.add_argument("--version", action="version", version=f"shelf {__version__}")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("init", help="create the shelf directory").set_defaults(fn=cmd_init)

    a = sub.add_parser("add", help="shelve a url")
    a.add_argument("url")
    a.add_argument("-w", "--why", default="", help="why it caught your eye")
    a.add_argument("-t", "--tags", default="", help="comma-separated tags")
    a.add_argument("-s", "--slug", default="", help="override the derived slug")
    a.add_argument("-k", "--kind", choices=KINDS, default="",
                   help="tool or reading (inferred from the url by default)")
    a.add_argument("-c", "--clone", action="store_true", help="also shallow-clone the repo")
    a.add_argument("--offline", action="store_true", help="skip GitHub metadata lookup")
    a.set_defaults(fn=cmd_add)

    f = sub.add_parser("find", help="ranked search, capped (start here)")
    f.add_argument("query", nargs="+")
    f.add_argument("-n", type=int, default=DEFAULT_HITS, help=f"max hits (default {DEFAULT_HITS})")
    f.add_argument("-k", "--kind", choices=KINDS, default="", help="only tools, or only reading")
    f.set_defaults(fn=cmd_find)

    sub.add_parser("tags", help="tag vocabulary and counts").set_defaults(fn=cmd_tags)

    for name, fn, helptext in (
        ("list", cmd_list, "one terse line per item"),
        ("print", cmd_print, "browsable view, grouped by kind then verdict"),
    ):
        s = sub.add_parser(name, help=helptext)
        s.add_argument("tag", nargs="?", default="", help="filter by tag")
        s.add_argument("-k", "--kind", choices=KINDS, default="", help="filter by kind")
        s.set_defaults(fn=fn)

    for name, fn, helptext in (
        ("show", cmd_show, "print one full note"),
        ("edit", cmd_edit, "open a note in $EDITOR"),
        ("clone", cmd_clone, "shallow-clone a shelved repo"),
    ):
        s = sub.add_parser(name, help=helptext)
        s.add_argument("slug")
        s.set_defaults(fn=fn)

    v = sub.add_parser("verdict", help="record a decision")
    v.add_argument("slug")
    v.add_argument("verdict", choices=VERDICTS, metavar="VERDICT",
                   help="tool: untried|trialling|adopted|rejected · "
                        "reading: unread|useful|noise")
    v.add_argument("--because", default=None, metavar="IDS",
                   help="constraint id(s) this decision rests on")
    v.set_defaults(fn=cmd_verdict)

    k = sub.add_parser("kind", help="read or change tool/reading")
    k.add_argument("slug")
    # default=None, not "": argparse <=3.8 runs _check_value on a *string* default for a
    # nargs='?' positional, so `shelf kind <slug>` in read mode would exit 2 on 3.8.
    k.add_argument("kind", nargs="?", choices=KINDS, default=None)
    k.set_defaults(fn=cmd_kind)

    sub.add_parser("constraints",
                   help="the standing facts — load once per session").set_defaults(fn=cmd_constraints)

    c = sub.add_parser("constraint", help="add / read / lift / drop one standing fact")
    c.add_argument("id")
    c.add_argument("text", nargs="?", default=None)
    c.add_argument("--lift", action="store_true", help="no longer true — show what rested on it")
    c.add_argument("--drop", action="store_true", help="delete the line (mistyped id)")
    c.add_argument("--force", action="store_true", help="drop even while items cite it")
    c.set_defaults(fn=cmd_constraint)

    r = sub.add_parser("revisit", help="decisions resting on a constraint, capped")
    r.add_argument("id")
    r.add_argument("-n", type=int, default=DEFAULT_HITS, help=f"max hits (default {DEFAULT_HITS})")
    r.set_defaults(fn=cmd_revisit)

    st = sub.add_parser("stats", help="HUMAN: is the shelf earning its keep? (grows with shelf)")
    st.add_argument("--dead", action="store_true", help="every never-retrieved item, not just 8")
    st.add_argument("--json", action="store_true", help="machine-readable dump of the counters")
    st.add_argument("--off", action="store_true", help="stop logging and delete the log")
    st.add_argument("--on", action="store_true", help="resume logging")
    st.set_defaults(fn=cmd_stats)

    sub.add_parser("index", help="regenerate the shelf README").set_defaults(fn=cmd_index)
    sub.add_parser("path", help="print the shelf directory").set_defaults(fn=cmd_path)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "fn", None):
        parser.print_help()
        return 0
    args.fn(args)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
