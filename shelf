#!/usr/bin/env python3
"""shelf — a context-budgeted store for tools you might use on a future project.

Notes live in $SHELF_DIR/items/*.md as markdown with YAML-ish frontmatter. Optional
shallow clones live in $SHELF_DIR/repos/ and are gitignored. The standing facts that
decide things for you live in $SHELF_DIR/constraints.md — one small file, loaded whole.

The design constraint is that this output usually lands in an AI agent's context
window, so `find` is ranked and hard-capped while the browsable views are kept
out of the agent's reach. See README.md for measured costs.

Stdlib only. Python 3.8+.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

__version__ = "0.2.0"

FIELDS = ("name", "kind", "url", "tags", "added", "verdict", "because",
          "stars", "license", "pushed", "desc", "why")
KINDS = ("tool", "reading")
KIND_LABEL = {"tool": "TOOLS", "reading": "READING"}
KIND_TITLE = {"tool": "Tools", "reading": "Reading"}
TOOL_VERDICTS = ("untried", "trialling", "adopted", "rejected")
READING_VERDICTS = ("unread", "useful", "noise")     # disjoint from the above — load-bearing
VERDICTS = TOOL_VERDICTS + READING_VERDICTS          # argparse choices; name kept
VERDICTS_BY_KIND = {"tool": TOOL_VERDICTS, "reading": READING_VERDICTS}
DEFAULT_VERDICT = {"tool": "untried", "reading": "unread"}
VERDICT_ORDER = {v: i for i, v in enumerate(
    ("adopted", "trialling", "untried", "rejected",   # tool: positive → parked → negative
     "useful", "unread", "noise"))}                   # reading: same shape
WHY_CAP = 110
DEFAULT_HITS = 8                                      # unchanged — the cap is the product
CONSTRAINT_CAP = 80                                   # display clip, the WHY_CAP analogue
CONSTRAINT_SOFT_MAX = 12                              # past this it is not a constraint list
CID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,23}$")   # 24 chars keeps `find` budget-neutral

# The verdict codes in the usage log. Two vocabularies means first letters collide
# (untried/unread/useful), so the map is explicit and asserted bijective in the tests.
VERDICT_CODE = {"untried": "u", "trialling": "t", "adopted": "a", "rejected": "r",
                "unread": "ur", "useful": "uf", "noise": "no"}
LETTER_VERDICT = {c: v for v, c in VERDICT_CODE.items()}

LOG_NAME = "log.jsonl"
LOG_IGNORE = "log.*"      # covers log.jsonl AND the log.tmp compaction scratch file
LOG_OFF_NAME = ".nolog"
LOG_MAX_BYTES = 262_144   # compaction trigger — about 1,300 events
LOG_KEEP_BYTES = 65_536   # raw events kept after compaction (byte-based: can't thrash)
LOG_TOP_MISSES = 40       # missed queries carried forward in a rollup
LOG_TOP_ITEMS = 400       # retrieved items carried forward in a rollup — without this the
                          # record grows with the shelf and LOG_MAX_BYTES stops being a cap
LOG_Q_CAP = 120           # chars of query text recorded
STATS_TOP = 8             # rows per section in the report
DEAD_GRACE_DAYS = 30      # an item is only dead weight once it has had a fair chance

TEMPLATE = """
## What it is

## When I'd reach for it

## Why not now

## If I trial it
"""

READING_TEMPLATE = """
## What it argues

## What I took from it

## What I'd push back on

## Where I'd apply it
"""

TEMPLATES = {"tool": TEMPLATE, "reading": READING_TEMPLATE}

CONSTRAINTS_HEADER = """# Constraints

Standing facts about this setup that decide things for you. Verdicts cite them by
id (`shelf verdict <slug> rejected --because <id>`), so when one changes,
`shelf revisit <id>` finds every decision that rested on it.

Keep this short — one screen, ~10 constraints. It is loaded whole, every session.
Bullets of the form "- id: text" are parsed as constraints; write prose as prose.

"""

CONSTRAINT_RE = re.compile(
    r"^\s*[-*]\s+`?(?P<id>[A-Za-z0-9][A-Za-z0-9._-]*)`?\s*:\s*(?P<rest>\S.*?)\s*$")
META_RE = re.compile(
    r"\s*\((?:since (?P<since>\d{4}-\d{2}-\d{2}))?"
    r"(?:(?:, )?lifted (?P<lifted>\d{4}-\d{2}-\d{2}))?\)$")


# ---------------------------------------------------------------- paths & io

def shelf_dir() -> pathlib.Path:
    return pathlib.Path(os.environ.get("SHELF_DIR", pathlib.Path.home() / ".shelf")).expanduser()


def items_dir() -> pathlib.Path:
    return shelf_dir() / "items"


def repos_dir() -> pathlib.Path:
    return shelf_dir() / "repos"


def constraints_path() -> pathlib.Path:
    return shelf_dir() / "constraints.md"


def die(msg: str, code: int = 1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def ensure_shelf():
    if not items_dir().is_dir():
        die(f"no shelf at {shelf_dir()} — run `shelf init` first")


def colour_on() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


# ---------------------------------------------------------------- item model

def slugify(value: str) -> str:
    value = re.sub(r"^https?://", "", value.strip().lower())
    value = value.rstrip("/").split("/")[-1]
    value = re.sub(r"\.git$", "", value)
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    return value.strip("-") or "item"


TOOL_HOSTS = ("github.com", "gitlab.com", "codeberg.org", "bitbucket.org", "sr.ht",
              "pypi.org", "npmjs.com", "crates.io", "rubygems.org", "pkg.go.dev",
              "hub.docker.com")
READING_HOSTS = ("arxiv.org", "medium.com", "substack.com", "dev.to", "youtube.com",
                 "youtu.be", "lobste.rs", "news.ycombinator.com", "ghost.io",
                 "hashnode.dev", "wordpress.com", "wikipedia.org")
READING_PATHS = ("/blog/", "/posts/", "/post/", "/article", "/writing/", "/talks/",
                 "/papers/", "/paper/", "/newsletter/", "/wiki/", "/abs/")


def infer_kind(url: str) -> str:
    """Guess reading vs tool from the url. Only ever promotes to `reading` on positive
    evidence — anything unrecognised stays `tool`, which is what every note written
    before this field existed already is."""
    u = url.strip().lower()
    m = re.match(r"^(?:https?://)?(?:www\.)?([^/?#]*)(.*)$", u)
    host, path = (m.group(1).split(":")[0], m.group(2)) if m else (u, "")
    hit = lambda hosts: any(host == h or host.endswith("." + h) for h in hosts)
    if hit(TOOL_HOSTS) or path.endswith(".git"):
        return "tool"                       # forge/registry wins over any path signal
    if hit(READING_HOSTS) or host.startswith("blog."):
        return "reading"
    if any(s in path for s in READING_PATHS) or path.endswith(".pdf"):
        return "reading"
    return "tool"


def parse(path: pathlib.Path) -> dict:
    text = path.read_text(encoding="utf-8")
    item = {k: "" for k in FIELDS}
    item.update(name=path.stem, body="", path=path)
    if not text.startswith("---"):
        item["body"] = text
        return item
    head, _, body = text.partition("---")[2].partition("---")
    for line in head.strip().splitlines():
        key, _, value = line.partition(":")
        key, value = key.strip(), value.strip()
        if key not in FIELDS:
            continue
        if value.startswith('"'):
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                pass
        item[key] = value.strip("[]") if key in ("tags", "because") else value
    item["body"] = body
    return item


def load() -> list:
    items = [parse(p) for p in sorted(items_dir().glob("*.md"))]
    return sorted(items, key=lambda i: i.get("added", ""), reverse=True)


def split_csv(value: str) -> list:
    return [x.strip() for x in value.split(",") if x.strip()]


def tags_of(item: dict) -> list:
    return split_csv(item["tags"])


def because_of(item: dict) -> list:
    return split_csv(item.get("because") or "")


def kind_of(item: dict) -> str:
    """Absent or unrecognised → tool. Every pre-kind note on disk is a tool."""
    k = (item.get("kind") or "").strip().lower()
    return k if k in KINDS else "tool"


def verdict_of(item: dict) -> str:
    """Never coerces a cross-kind verdict — only fills in the default when blank."""
    return (item.get("verdict") or "").strip() or DEFAULT_VERDICT[kind_of(item)]


def clip(text: str, cap: int = WHY_CAP) -> str:
    text = " ".join(text.split())
    if len(text) <= cap:
        return text
    return text[: cap - 1].rsplit(" ", 1)[0] + "…"


def gh_meta(url: str) -> dict:
    """Enrich a GitHub URL with stars/license/last-push. Never fatal — the shelf
    works fine offline, it just records less."""
    m = re.match(r"^https?://github\.com/([^/]+/[^/#?]+)", url.strip())
    if not m:
        return {}
    repo = re.sub(r"\.git$", "", m.group(1))
    req = urllib.request.Request(
        f"https://api.github.com/repos/{repo}",
        headers={"Accept": "application/vnd.github+json", "User-Agent": f"shelf/{__version__}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            d = json.load(resp)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
        return {}
    return {
        "stars": str(d.get("stargazers_count", "")),
        "license": (d.get("license") or {}).get("spdx_id") or "none",
        "pushed": (d.get("pushed_at") or "")[:10],
        "desc": d.get("description") or "",
    }


def write_item(slug: str, fields: dict, body: str = TEMPLATE) -> pathlib.Path:
    lines = ["---"]
    for key in FIELDS:
        value = fields.get(key, "")
        if not value:
            continue
        if key in ("tags", "because"):
            lines.append(f"{key}: [{value}]")
        elif key in ("why", "desc"):
            lines.append(f"{key}: {json.dumps(value, ensure_ascii=False)}")
        else:
            lines.append(f"{key}: {value}")
    lines += ["---", body.rstrip() + "\n"]
    path = items_dir() / f"{slug}.md"
    path.write_text("\n".join(lines), encoding="utf-8")
    return path


def upsert_field(text: str, key: str, value: str) -> str:
    """Set, replace or (empty value) delete one frontmatter field. Only ever touches
    the frontmatter slice, so a body line starting `verdict:` cannot be clobbered.
    A missing field is inserted in FIELDS order, not appended."""
    if not text.startswith("---"):
        return f"---\n{key}: {value}\n---\n{text}" if value else text
    end = text.find("\n---", 3)
    if end < 0:
        end = len(text)
    head, rest = text[:end], text[end:]
    pat = re.compile(r"^%s:.*$" % re.escape(key), re.M)
    if pat.search(head):
        if value:
            head = pat.sub(lambda _: f"{key}: {value}", head, count=1)
        else:
            head = re.sub(r"\n\n+", "\n", pat.sub("", head, count=1))
    elif value:
        lines = head.split("\n")
        rank = FIELDS.index(key) if key in FIELDS else len(FIELDS)
        at = len(lines)
        for n, line in enumerate(lines):
            k = line.partition(":")[0].strip()
            if k in FIELDS and FIELDS.index(k) > rank:
                at = n
                break
        lines.insert(at, f"{key}: {value}")
        head = "\n".join(lines)
    return head + rest


# ---------------------------------------------------------------- constraints
# The small thing. Bounded by the user's reality, not by shelf size, so it gets the
# opposite treatment to items: always loaded, never searched.

def parse_constraint(line: str):
    """`- \\`id\\`: text  (since YYYY-MM-DD, lifted YYYY-MM-DD)` → dict, else None.
    Forgiving on read — a hand-typed `- pg13: pinned to 13` parses fine — because
    hand-editing the file has to stay safe."""
    m = CONSTRAINT_RE.match(line)
    if not m:
        return None
    rest, since, lifted = m.group("rest"), "", ""
    meta = META_RE.search(rest)
    if meta and (meta.group("since") or meta.group("lifted")):
        since, lifted = meta.group("since") or "", meta.group("lifted") or ""
        rest = rest[: meta.start()].rstrip()
    return {"id": m.group("id"), "text": rest, "since": since, "lifted": lifted}


def fmt_constraint(c: dict) -> str:
    """Exact inverse of parse_constraint. Backticks always written, never required."""
    meta = []
    if c.get("since"):
        meta.append("since " + c["since"])
    if c.get("lifted"):
        meta.append("lifted " + c["lifted"])
    tail = "  ({})".format(", ".join(meta)) if meta else ""
    return "- `{}`: {}{}".format(c["id"], c["text"], tail)


def load_constraints() -> list:
    """File order preserved. A missing file returns [] — that IS the v0.1 upgrade path."""
    path = constraints_path()
    if not path.exists():
        return []
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        c = parse_constraint(line)
        if c:
            out.append(c)
    return out


def edit_constraint(cid: str, text=None, lift=False, drop=False) -> dict:
    """Line-surgical: prose, headers and hand-written formatting survive untouched."""
    path = constraints_path()
    lines = (path.read_text(encoding="utf-8").splitlines() if path.exists()
             else CONSTRAINTS_HEADER.splitlines())
    found, last = None, -1
    for n, line in enumerate(lines):
        c = parse_constraint(line)
        if not c:
            continue
        last = n
        if c["id"] == cid:
            found = (n, c)
    if found is None:
        c = {"id": cid, "text": text or "", "created": True,
             "since": datetime.date.today().isoformat(), "lifted": ""}
        lines.insert(last + 1 if last >= 0 else len(lines), fmt_constraint(c))
    else:
        n, c = found
        c["created"] = False
        if drop:
            del lines[n]
        else:
            if text is not None:
                c["text"] = text
            if lift:
                c["lifted"] = datetime.date.today().isoformat()
            lines[n] = fmt_constraint(c)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return c


def citations() -> dict:
    """cid → [item, …]. One load() pass feeds the ×N counts, revisit and orphan detection."""
    out: dict = {}
    for item in load():
        for cid in because_of(item):
            out.setdefault(cid, []).append(item)
    return out


def die_unknown_constraint(cid: str, known):
    die(f"unknown constraint: {cid}\n"
        f"  known: {', '.join(known) if known else '(none yet)'}\n"
        f'  add it:  shelf constraint {cid} "<the standing fact>"')


def plural(n: int, word: str) -> str:
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


def churn_sorted(items: list) -> list:
    """Most-likely-to-change first: VERDICT_ORDER negated, so rejected leads adopted."""
    return sorted(items, key=lambda i: (-VERDICT_ORDER.get(verdict_of(i), -1), i["name"]))


# ---------------------------------------------------------------- telemetry
# A local, opt-out usage log so you can see whether the shelf is earning its keep.
# Two rules: it never adds a byte to `find`/`show` output, and it never raises.
# If anything goes wrong we lose telemetry, not the tool.

def log_path() -> pathlib.Path:
    return shelf_dir() / LOG_NAME


def logging_off() -> bool:
    return bool(os.environ.get("SHELF_NO_LOG")) or (shelf_dir() / LOG_OFF_NAME).exists()


def ignore_log_in_git():
    """The shelf is a git repo and people sync it. Queries stay on this machine — and
    that means the compaction scratch file too, which holds the same verbatim query
    text and survives an interrupted rewrite. One pattern covers both."""
    gitignore = shelf_dir() / ".gitignore"
    text = gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""
    if LOG_IGNORE in text.split():
        return
    with open(gitignore, "a", encoding="utf-8") as fh:
        fh.write(("" if not text or text.endswith("\n") else "\n") + LOG_IGNORE + "\n")


def log_event(op: str, **fields):
    """Append one JSONL record. Silent and best-effort: a read-only shelf, a full
    disk or a hostile filesystem costs you stats, never a search."""
    if logging_off():
        return
    try:
        path = log_path()
        if not path.exists():
            ignore_log_in_git()
        elif path.stat().st_size > LOG_MAX_BYTES:
            compact_log()
        record = {"t": datetime.datetime.now().isoformat(timespec="seconds"), "op": op}
        record.update(fields)
        blob = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, blob)  # one write() under O_APPEND — whole records, no interleaving
        finally:
            os.close(fd)
    except Exception:  # noqa: BLE001 — telemetry must never break retrieval
        pass


def hit_code(item: dict) -> str:
    """`slug:code` — the verdict as it was when surfaced, not as it is now."""
    return f"{item['name']}:{VERDICT_CODE.get(verdict_of(item), 'u')}"


def new_stats() -> dict:
    return {"since": "", "to": "", "finds": 0, "misses": 0, "shows": 0, "piped": 0,
            "missed": {}, "surfaced": {}, "opened": {}, "items": {}}


def bump(counts: dict, key: str, n: int = 1):
    counts[key] = counts.get(key, 0) + n


def fold(acc: dict, rec: dict):
    """Fold one record into an accumulator. Shared by `stats` and compaction, so a
    compacted shelf and a fresh one can never disagree about what a number means."""
    stamp = rec.get("t") or rec.get("since")
    if stamp:
        acc["since"] = min(acc["since"], stamp) if acc["since"] else stamp
        acc["to"] = max(acc["to"], rec.get("to") or rec.get("t") or "")
    op = rec.get("op")
    if op == "find":
        acc["finds"] += 1
        acc["piped"] += 0 if rec.get("tty") else 1
        hits = rec.get("hits") or []
        if not hits:
            acc["misses"] += 1
            bump(acc["missed"], rec.get("q", ""))
        for code in hits:
            slug, _, letter = code.rpartition(":")
            acc["items"].setdefault(slug, [0, 0])[0] += 1
            bump(acc["surfaced"], LETTER_VERDICT.get(letter, "untried"))
    elif op == "show":
        acc["shows"] += 1
        acc["piped"] += 0 if rec.get("tty") else 1
        acc["items"].setdefault(rec.get("slug", ""), [0, 0])[1] += 1
        bump(acc["opened"], LETTER_VERDICT.get(rec.get("v", ""), "untried"))
    elif op == "rollup":
        for key in ("finds", "misses", "shows", "piped"):
            acc[key] += rec.get(key, 0)
        for key in ("missed", "surfaced", "opened"):
            for name, n in (rec.get(key) or {}).items():
                bump(acc[key], name, n)
        for slug, pair in (rec.get("items") or {}).items():
            entry = acc["items"].setdefault(slug, [0, 0])
            entry[0] += pair[0]
            entry[1] += pair[1]


def read_log() -> list:
    """Every parseable record, oldest first. A half-written line is skipped, not fatal."""
    try:
        text = log_path().read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    out = []
    for line in text.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict) and rec.get("op"):
            out.append(rec)
    return out


def compact_log():
    """Fold everything but a recent tail into one rollup record, so lifetime counters
    survive truncation instead of silently resetting. ~4ms, once per ~1,300 events.
    Not an atomic append (tmp + os.replace), so a concurrent find can lose at most
    one record — telemetry only, and cheaper than taking a lock on the hot path.

    Every carried-forward map is capped, because a rollup that grows with the shelf
    would push the record past LOG_MAX_BYTES and make every later find recompact a
    log it can no longer shrink. The scalar counters are exact; the per-item map
    keeps the top LOG_TOP_ITEMS by retrieval count, so anything in real use survives
    and a once-retrieved item on a huge shelf may fall back to `never retrieved`."""
    recs = read_log()
    events = [r for r in recs if r.get("op") != "rollup"]
    dumps = lambda r: json.dumps(r, ensure_ascii=False, separators=(",", ":"))
    keep, budget = [], LOG_KEEP_BYTES
    for rec in reversed(events):
        line = dumps(rec)
        budget -= len(line) + 1
        if budget < 0:
            break
        keep.append(line)
    keep.reverse()
    acc = new_stats()
    for rec in recs[: len(recs) - len(keep)]:
        fold(acc, rec)
    live = {p.stem for p in items_dir().glob("*.md")}
    kept_items = sorted(((k, v) for k, v in acc["items"].items() if k in live),
                        key=lambda p: (-(p[1][0] + p[1][1]), p[0]))
    acc["items"] = dict(kept_items[:LOG_TOP_ITEMS])
    acc["missed"] = dict(sorted(acc["missed"].items(), key=lambda p: -p[1])[:LOG_TOP_MISSES])
    acc["op"] = "rollup"
    ignore_log_in_git()  # the tmp below holds query text; make sure git is told first
    tmp = log_path().with_suffix(".tmp")
    blob = ("\n".join([dumps(acc)] + keep) + "\n").encode("utf-8")
    try:
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, blob)
        finally:
            os.close(fd)
        os.replace(str(tmp), str(log_path()))
    except Exception:
        try:
            tmp.unlink()  # a half-written tmp is verbatim query history, left behind
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- commands

def cmd_init(args):
    for d in (items_dir(), repos_dir()):
        d.mkdir(parents=True, exist_ok=True)
    gitignore = shelf_dir() / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text(f"repos/\n{LOG_IGNORE}\n", encoding="utf-8")
    if not constraints_path().exists():
        constraints_path().write_text(CONSTRAINTS_HEADER, encoding="utf-8")
    if not (shelf_dir() / ".git").exists() and shutil.which("git"):
        subprocess.run(["git", "init", "-q"], cwd=shelf_dir(), check=False)
    render_index()
    print(f"shelf ready at {shelf_dir()}")
    print("  add your first item:  shelf add <url> -w \"why it caught your eye\" -t tag")
    print("  record a standing fact:  shelf constraint single-node \"no Redis, one box\"")
    print(f"  find/show are logged to {LOG_NAME} (local, gitignored) — `shelf stats`, "
          "`shelf stats --off`")


def cmd_add(args):
    ensure_shelf()
    slug = args.slug or slugify(args.url)
    path = items_dir() / f"{slug}.md"
    if path.exists():
        die(f"already shelved: {path}\n  edit it with `shelf edit {slug}`")
    kind = args.kind or infer_kind(args.url)
    fields = {
        "name": slug,
        "kind": kind,
        "url": args.url,
        "tags": ",".join(t.strip() for t in args.tags.split(",") if t.strip()) if args.tags else "",
        "added": datetime.date.today().isoformat(),
        "verdict": DEFAULT_VERDICT[kind],
        "why": args.why or "",
    }
    if not args.offline:
        fields.update(gh_meta(args.url))
    write_item(slug, fields, TEMPLATES[kind])
    if args.clone:
        clone_repo(slug)
    render_index()
    print(f"shelved → {path}  ({kind})")
    print(f"  now fill in the note: shelf edit {slug}")


def clone_repo(slug: str):
    item = parse(items_dir() / f"{slug}.md") if (items_dir() / f"{slug}.md").exists() else None
    if item is None:
        die(f"no such item: {slug}")
    url = item["url"]
    if not re.search(r"github\.com|gitlab\.com|\.git$", url):
        die(f"not a git url: {url}")
    dest = repos_dir() / slug
    if dest.exists():
        print(f"already cloned: {dest}")
        return
    repos_dir().mkdir(parents=True, exist_ok=True)
    result = subprocess.run(["git", "clone", "--depth", "1", "-q", url, str(dest)], check=False)
    if result.returncode:
        die(f"clone failed: {url}")
    print(f"cloned → {dest}")


def cmd_clone(args):
    ensure_shelf()
    clone_repo(args.slug)


def score(item: dict, terms: list) -> int:
    """Weight name and tag hits above body hits so precision holds as the shelf grows."""
    total = 0
    for term in terms:
        pat = re.compile(re.escape(term), re.I)
        total += 10 if pat.search(item["name"]) else 0
        total += 6 if any(pat.search(t) for t in tags_of(item)) else 0
        total += 4 if pat.search(item["why"]) else 0
        total += 1 if pat.search(item["body"]) else 0
    return total


def emit_hits(items: list, n: int, more_hint: str, tail: str, hide=()) -> list:
    """The one bounded renderer, shared by find / revisit / --lift so the cap and the
    line format cannot drift. A cited item spends its constraint ids INSIDE the same
    WHY_CAP allowance as the why text, so the line count and the character ceiling are
    identical cited or not. That is a ceiling, not a free lunch: the ids only displace
    prose once the why is at the cap. On a why shorter than that they are an addition —
    measured at ~3 tokens per cited hit, ~24 over a full 8-hit page."""
    shown = items[:n]
    for i in shown:
        print(f"{i['name']}  [{verdict_of(i)}]  {i['url']}")
        ids = [c for c in because_of(i) if c not in hide]
        tag = " ".join(ids[:2]) + (f" +{len(ids) - 2}" if len(ids) > 2 else "")
        if i["why"] or tag:
            body = clip(i["why"], max(WHY_CAP - len(tag) - 3, 24)) if tag else clip(i["why"])
            print(f"    {tag} · {body}" if tag else f"    {body}")
    if len(items) > n:
        print(f"… {len(items) - n} more — {more_hint}")
    print(tail)
    return shown


def cmd_find(args):
    ensure_shelf()
    items = [i for i in load() if not args.kind or kind_of(i) == args.kind]
    terms = [t for t in args.query if t.strip()]
    hits = sorted(
        [(score(i, terms), i) for i in items if score(i, terms) > 0], key=lambda p: -p[0]
    )
    shown = []
    if not hits:
        print(f"nothing shelved matches: {' '.join(terms)}")
        print(f"({len(items)} items on the shelf — `shelf tags` for the vocabulary)")
    else:
        shown = emit_hits([i for _, i in hits], args.n,
                          f"narrow the query or `-n {len(hits)}`",
                          "→ `shelf show <name>` for the full note")
    log_event("find", q=clip(" ".join(terms), LOG_Q_CAP), n=len(hits), tty=int(sys.stdout.isatty()),
              hits=[hit_code(i) for i in shown[:DEFAULT_HITS]])


def cmd_revisit(args):
    """Every decision resting on one constraint — same cap, same renderer as find."""
    ensure_shelf()
    known = {c["id"]: c for c in load_constraints()}
    if args.id not in known:
        die_unknown_constraint(args.id, known)
    text = clip(known[args.id]["text"], CONSTRAINT_CAP)
    hits = churn_sorted(citations().get(args.id, []))
    if not hits:
        print(f"nothing cites `{args.id}` yet — {text}")
        return
    verb = "rests" if len(hits) == 1 else "rest"
    print(f"{plural(len(hits), 'decision')} {verb} on `{args.id}` — {text}")
    emit_hits(hits, args.n, f"`shelf revisit {args.id} -n {len(hits)}`",
              "→ `shelf show <name>` before re-deciding", hide={args.id})


def cmd_constraints(args):
    """The always-loaded view: run once a session and keep it. O(1) in shelf size."""
    ensure_shelf()
    cons = load_constraints()
    cites = citations()
    dim, off = ("\033[2m", "\033[0m") if colour_on() else ("", "")
    live = [c for c in cons if not c["lifted"]]
    shown = [c for c in cons if not c["lifted"] or cites.get(c["id"])]
    if not shown:
        print("no constraints yet")
        print('  add one:  shelf constraint single-node "no Redis, no Kafka — one box"')
    else:
        for c in shown:
            n = len(cites.get(c["id"], ()))
            count = f"×{n}" if n else ""
            text = clip(c["text"], CONSTRAINT_CAP)
            if c["lifted"]:
                text = f"{dim}lifted {c['lifted']} — was: {text}{off}"
            print(f"{c['id']:<14} {dim}{count:<3}{off} {text}")
        tail = [f"{len(live)} live"]
        for c in shown:
            if not c["lifted"]:
                continue
            n = len(cites.get(c["id"], ()))
            tail.append(f"{c['id']} lifted with {plural(n, 'decision')} "
                        f"still on it — `shelf revisit {c['id']}`")
        print(f"{dim}{' · '.join(tail)}{off}")
    orphans = [cid for cid in sorted(cites) if cid not in {c["id"] for c in cons}]
    if orphans:
        n = len({i["name"] for cid in orphans for i in cites[cid]})
        print(f"! {plural(n, 'item')} cite unknown constraints: {', '.join(orphans[:5])}",
              file=sys.stderr)
    if len(live) > CONSTRAINT_SOFT_MAX:
        print(f"! {len(live)} live constraints — over {CONSTRAINT_SOFT_MAX} this is a wiki, "
              "not a constraint set; it is loaded every session", file=sys.stderr)


def cmd_constraint(args):
    ensure_shelf()
    cid = args.id
    cons = {c["id"]: c for c in load_constraints()}
    cites = citations()
    n = len(cites.get(cid, ()))

    if args.drop:
        if cid not in cons:
            die_unknown_constraint(cid, cons)
        if n and not args.force:
            die(f"refusing: {plural(n, 'item')} cite `{cid}`\n"
                f"  lift it instead:  shelf constraint {cid} --lift\n"
                f"  or force:         shelf constraint {cid} --drop --force")
        edit_constraint(cid, drop=True)
        render_index()
        print(f"dropped `{cid}`"
              + (f" — {plural(n, 'item')} still cite it (`shelf constraints`)" if n else ""))
        return

    if args.lift:
        if cid not in cons:
            die_unknown_constraint(cid, cons)
        c = edit_constraint(cid, text=args.text, lift=True)
        render_index()
        hits = churn_sorted(cites.get(cid, []))
        if not hits:
            print(f"lifted `{cid}` ({c['lifted']}) — nothing rested on it")
            return
        print(f"lifted `{cid}` ({c['lifted']}) — "
              f"{plural(len(hits), 'decision')} rested on it:")
        emit_hits(hits, DEFAULT_HITS, f"`shelf revisit {cid} -n {len(hits)}`",
                  "→ re-decide with `shelf verdict <slug> <verdict>`", hide={cid})
        return

    if args.text is None:                       # read one — the bounded landing spot
        if cid not in cons:
            die_unknown_constraint(cid, cons)
        c = cons[cid]
        meta = [m for m in (f"since {c['since']}" if c["since"] else "",
                            f"lifted {c['lifted']}" if c["lifted"] else "") if m]
        suffix = f"  ({', '.join(meta)})" if meta else ""
        count = f"×{n}" if n else ""
        print(f"{cid:<14} {count:<3} {clip(c['text'], CONSTRAINT_CAP)}{suffix}")
        return

    if not CID_RE.match(cid):
        die(f"bad constraint id: {cid}\n"
            "  ids are lowercase, ≤24 chars, [a-z0-9._-] — e.g. `single-node`, `pg13`")
    c = edit_constraint(cid, text=args.text)
    render_index()
    if c["created"]:
        print(f"added `{cid}` (since {c['since']})")
        print(f"  cite it:  shelf verdict <slug> rejected --because {cid}")
    else:
        verb = "cites" if n == 1 else "cite"
        print(f"updated `{cid}`"
              + (f" — {plural(n, 'decision')} {verb} it (`shelf revisit {cid}`)" if n else ""))


