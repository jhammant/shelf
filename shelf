def cmd_kind(args):
    """Read or change an item's kind. Swaps the scaffold only while the body is still
    the untouched template, and migrates the verdict only when it is the old default."""
    ensure_shelf()
    path = items_dir() / f"{args.slug}.md"
    if not path.exists():
        die(f"no such item: {args.slug}")
    item = parse(path)
    old = kind_of(item)
    if not args.kind:
        print(old)
        return
    new = args.kind
    text = upsert_field(path.read_text(encoding="utf-8"), "kind", new)
    pristine = (item["body"] or "").strip() == TEMPLATES[old].strip()
    end = text.find("\n---", 3)
    if pristine and end >= 0:
        text = text[: end + 4] + "\n" + TEMPLATES[new].rstrip() + "\n"
    current = (item["verdict"] or "").strip()
    migrate = not current or current == DEFAULT_VERDICT[old]
    if migrate:
        text = upsert_field(text, "verdict", DEFAULT_VERDICT[new])
    path.write_text(text, encoding="utf-8")
    render_index()
    print(f"{args.slug} → {new}")
    print("  scaffold swapped (note body was still empty)" if pristine
          else "  note body kept — it has your writing in it")
    if migrate:
        print(f"  verdict {current or DEFAULT_VERDICT[old]} → {DEFAULT_VERDICT[new]}")
    elif current not in VERDICTS_BY_KIND[new]:
        print(f"  warning: verdict `{current}` is not a {new} verdict")
        print(f"           set one of: {' · '.join(VERDICTS_BY_KIND[new])}")


